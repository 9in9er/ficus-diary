# Public Firebase web app configuration (Firebase Console > Project settings).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# SERVER ONLY. Never add REACT_APP_ to these variable names.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET_NAME=ficus-diary-photos
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net

# Firebase Admin service account from the SAME Firebase project as the web app.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the PEM key with literal \n escapes, surrounded by double quotes.
FIREBASE_PRIVATE_KEY=""

# Permanent deletion requires the exact server value true; false keeps it disabled.
# No automatic trash cleanup is run.
ENABLE_PERMANENT_PLANT_DELETE=false
