rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /plants/{plantId} {
      function isOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }
      allow read: if isOwner();
      // Temporary bridge for already open clients that still send base64 photo.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name', 'acquiredAt', 'description', 'price', 'links', 'isWishlisted',
          'wateringLog', 'fertilizingLog', 'notes', 'userId', 'createdAt',
          'pinned', 'hidden', 'deletedAt', 'replanted', 'photo'
        ]);
      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && resource.data.get('_photoDeleting', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'acquiredAt', 'description', 'price', 'links', 'isWishlisted',
          'wateringLog', 'fertilizingLog', 'notes', 'createdAt',
          'pinned', 'hidden', 'deletedAt', 'replanted', 'photo'
        ])
        // Never accept a legacy photo replacement once the API owns the photo.
        // An old form may add photo:null to a new S3 document; this is harmless.
        && (!resource.data.keys().hasAny(['photoKey'])
          || request.resource.data.get('photo', null) == resource.data.get('photo', null));
      // Old clients must not bypass ENABLE_PERMANENT_PLANT_DELETE=false.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
